# HandsFree — copy to .env (gitignored)

# How the typed questions are answered.
#   auto  (default) → use TYPESAFE_API_KEY if present, otherwise the embedded local model
#   local           → always embedded local model (free, offline, no key)
#   api             → always TypeSafe System One (needs a key)
# HANDSFREE_BACKEND=auto

# Optional: use the hosted API instead of the local model.
# Get a key at https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# Where the decision model (.gguf) lives. If unset, HandsFree looks in
# models/ first, then common install locations such as ~/.lmstudio/models.
# HANDSFREE_MODEL=C:\path\to\Jev-Style-0.8B-Decision-v3-Q4_K_M.gguf

# Inference device. true uses the GPU and falls back to CPU automatically
# if the GPU context cannot be allocated. Set false to force CPU.
# HANDSFREE_GPU=true

# Optional tuning
# PORT=8787
# HANDSFREE_CONTEXT=4096